{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [


        {
            "name": "Listen for Xdebug",
            "type": "php",
            "request": "launch",
            "port": 9003,
            "pathMappings": {
                "/var/www/borelli/public_html/estoque_Linux": "${workspaceFolder}"
            }
        },
        {
            "name": "Launch CLI Script",
            "type": "php",
            "request": "launch",
            "program": "${file}",
            "cwd": "${fileDirname}"
        },
        {
            "name": "Launch CLI Script - sync2.php",
            "type": "php",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/sync2.php",
            "cwd": "${workspaceFolder}/scripts",
            "pathMappings": {
                "/var/www/borelli/public_html/estoque_Linux": "${workspaceFolder}"
            },
            "env": {
                "XDEBUG_MODE": "debug",
                "XDEBUG_CONFIG": "client_host=127.0.0.1 client_port=9003 idekey=VSCODE"
            }
        }
    ]
    }